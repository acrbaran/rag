[Unit]
Description=Rethra (docker compose)
Requires=docker.service rethra-firstboot.service
After=docker.service network-online.target rethra-firstboot.service
Wants=network-online.target
# Kritik: Requires=rethra-firstboot.service, ilk açılış init işlemi başarısız olduğunda bu hizmetin de başlamamasını sağlar,
# firstboot rastgele anahtarları başarıyla oluşturmadan .env.example içindeki varsayılan düz metin parolayla postgres
# veri birimini başlatmasını önler. rethra-firstboot.service, önceden başlatılmış örneklerde
# ConditionPathExists=!/opt/Rethra/.firstboot.done nedeniyle atlanır; atlanma = başarıdır,
# bu hizmetin sonraki yeniden başlatmalarını engellemez.

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/Rethra
ExecStart=@DOCKER_BIN@ compose up -d
ExecStop=@DOCKER_BIN@ compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
