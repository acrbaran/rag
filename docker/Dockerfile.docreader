# =========================
# Derleme aşaması (hafif: yalnızca belge ayrıştırma + görüntü çıkarma, OCR/VLM yok)
# =========================
FROM python:3.10.18-bookworm AS builder

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@http://deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && \
        sed -i "s@http://security.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi

WORKDIR /app

# Derleme bağımlılıklarını yükle
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    libjpeg-dev \
    zlib1g-dev \
    libffi-dev \
    libgl1 \
    libglib2.0-0 \
    wget \
    antiword \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Yerel protoc kurulum paketi olup olmadığını kontrol et; varsa çevrimdışı, yoksa çevrimiçi yükle
ARG TARGETARCH
COPY packages/ /app/packages/
RUN ls -lah /app/packages/
# BuildKit ve geleneksel derlemeyle uyumlu: TARGETARCH boşsa uname ile algıla
RUN if [ -z "$TARGETARCH" ]; then \
        case $(uname -m) in \
            "x86_64") TARGETARCH="amd64" ;; \
            "aarch64") TARGETARCH="arm64" ;; \
            "armv7l") TARGETARCH="arm" ;; \
            *) echo "Unsupported architecture: $(uname -m)" && exit 1 ;; \
        esac; \
        echo "[Otomatik algılama] Mimari: $TARGETARCH"; \
    else \
        echo "[BuildKit] Mimari: $TARGETARCH"; \
    fi && \
    case $TARGETARCH in \
        "amd64") PROTOC_ARCH="x86_64" ;; \
        "arm64") PROTOC_ARCH="aarch_64" ;; \
        "arm") PROTOC_ARCH="arm" ;; \
        *) echo "Unsupported architecture for protoc: $TARGETARCH" && exit 1 ;; \
    esac && \
    PROTOC_PACKAGE="protoc-3.19.4-linux-${PROTOC_ARCH}.zip" && \
    if [ -f "/app/packages/${PROTOC_PACKAGE}" ]; then \
        echo "Yerel protoc kurulum paketi bulundu, çevrimdışı kurulum yapılacak"; \
        cp /app/packages/${PROTOC_PACKAGE} /app/ && \
        unzip -o /app/${PROTOC_PACKAGE} -d /usr/local && \
        chmod +x /usr/local/bin/protoc && \
        rm -f /app/${PROTOC_PACKAGE}; \
    else \
        echo "Yerel protoc kurulum paketi bulunamadı, çevrimiçi kurulum yapılacak"; \
        curl -LO https://github.com/protocolbuffers/protobuf/releases/download/v3.19.4/${PROTOC_PACKAGE} && \
        unzip -o ${PROTOC_PACKAGE} -d /usr/local && \
        chmod +x /usr/local/bin/protoc && \
        rm -f ${PROTOC_PACKAGE}; \
    fi

# Bağımlılık dosyalarını kopyala
COPY docreader/pyproject.toml docreader/uv.lock ./
RUN pip install uv --break-system-packages && \
    python -m uv sync --locked --no-dev

# Kaynak kodu ve oluşturma betiklerini kopyala
COPY docreader docreader

# protobuf kodunu oluştur (venv içindeki grpc_tools kullanılarak)
ENV PATH="/app/.venv/bin:${PATH}"
RUN chmod +x docreader/scripts/generate_proto.sh && \
    bash docreader/scripts/generate_proto.sh

# =========================
# Çalışma aşaması (hafif)
# =========================
FROM python:3.10.18-bookworm AS runner

ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@http://deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && \
        sed -i "s@http://security.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi

WORKDIR /app

# Çalışma zamanı bağımlılıklarını yükle (OCR/PaddleOCR ile ilgili bağımlılıklar kaldırıldı)
RUN apt-get update && apt-get install -y \
    libjpeg62-turbo \
    wget \
    gnupg \
    openjdk-17-jre-headless \
    libgl1 \
    libglib2.0-0 \
    antiword \
    tar \
    dpkg \
    libxinerama1 \
    libfontconfig1 \
    libdbus-glib-1-2 \
    libcairo2 \
    libcups2 \
    libglu1-mesa \
    libsm6 \
    libreoffice \
    curl \
    && rm -rf /var/lib/apt/lists/*

# grpc_health_probe yükle
ARG TARGETARCH
# BuildKit ve geleneksel derlemeyle uyumlu: TARGETARCH boşsa uname ile algıla
RUN if [ -z "$TARGETARCH" ]; then \
        case $(uname -m) in \
            "x86_64") TARGETARCH="amd64" ;; \
            "aarch64") TARGETARCH="arm64" ;; \
            "armv7l") TARGETARCH="arm" ;; \
            *) echo "Unsupported architecture: $(uname -m)" && exit 1 ;; \
        esac; \
        echo "[Otomatik algılama] Mimari: $TARGETARCH"; \
    else \
        echo "[BuildKit] Mimari: $TARGETARCH"; \
    fi && \
    GRPC_HEALTH_PROBE_VERSION=v0.4.24 && \
    case $TARGETARCH in \
        "amd64") ARCH="amd64" ;; \
        "arm64") ARCH="arm64" ;; \
        "arm") ARCH="arm" ;; \
        *) echo "Unsupported architecture: $TARGETARCH" && exit 1 ;; \
    esac && \
    wget -qO/bin/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-${ARCH} && \
    chmod +x /bin/grpc_health_probe

# Derleme aşamasından yüklenmiş bağımlılıkları ve oluşturulmuş kodu kopyala
ENV VIRTUAL_ENV=/app/.venv
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

COPY --from=builder /usr/local/bin /usr/local/bin

# Playwright tarayıcısını yükle (web sayfası ayrıştırma)
RUN python -m playwright install webkit
RUN python -m playwright install-deps webkit

COPY docreader/pyproject.toml docreader/uv.lock ./
COPY --from=builder /app/docreader docreader

# Paylaşılan geçici görüntü dizini oluştur
RUN mkdir -p /tmp/docreader

# gRPC bağlantı noktasını dışa aç
EXPOSE 50051

# Probe ARM crypto instructions before importing native dependencies. The
# entrypoint only enables portable OpenSSL implementations after a SIGILL.
ENTRYPOINT ["/app/.venv/bin/python", "-m", "docreader.container_entrypoint"]
# Dependencies are installed from uv.lock at build time; do not mutate them at boot.
CMD ["/app/.venv/bin/python", "-m", "docreader.main"]
