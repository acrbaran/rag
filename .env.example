# =====================================================================
# Rethra ortam değişkeni yapılandırma örneği
# ---------------------------------------------------------------------
# Kullanım talimatları:
#   1. Bu dosyayı .env olarak kopyalayın: cp .env.example .env
#   2. Tüm yer tutucuları gerçek değerlerle değiştirin (özellikle ⚠️ ZORUNLU olarak işaretlenenleri)
#   3. .env dosyasının sürüm kontrolüne gönderilmediğinden emin olun
#
# Yapılandırma enjeksiyon mekanizması:
#   - app hizmeti bu dosyadaki tüm değişkenleri env_file: .env aracılığıyla okur;
#   - docreader / mcp / frontend / odl-hybrid hizmetlerinde env_file yoktur, yalnızca kendi
#     environment bölümünde açıkça listelenen değişkenleri tüketir (bkz. docker-compose.yml).
#
# Gruplama sırası:
#   A. Dağıtım temelleri        İmaj, çalışma zamanı, ağ
#   B. Veri ve depolama      Veritabanı, Redis, dosya depolama, nesne depolama
#   C. Arama ve grafik      Vektör veritabanı, bilgi grafiği
#   D. Modeller            LLM/VLM, yerleşik modeller
#   E. Belge ayrıştırma        Docreader, görev zaman aşımı
#   F. Kimlik doğrulama ve alan yalıtımı  JWT/AES, kayıt, RBAC, OIDC
#   G. Agent ve sandbox    Sandbox, Skills, Agent zaman aşımı
#   H. İsteğe bağlı entegrasyonlar        Web araması, MCP Server
#   I. Gözlemlenebilirlik        Langfuse
#   J. Güvenlik ve ince ayar      SSRF, proxy, eşzamanlılık
# =====================================================================


# #####################################################################
# A. Dağıtım temelleri
# #####################################################################

# ========== A1. İmaj sürümü ve derleme ==========
# Rethra yerel imaj etiketi. Kaynak kod güncellendikten sonra yeniden oluşturmak için docker compose up --build -d çalıştırın.
RETHRA_VERSION=latest
# Alpine apk imaj kaynağı (app imajını oluşturmak için; varsayılan kaynak için boş bırakın; yavaş bağlantılarda yakın bir Debian aynası ayarlanabilir, ör. ftp.tr.debian.org).
APK_MIRROR_ARG=
# app imajı oluşturulurken anydoc işlem içi ayrıştırma motorunun bağlanıp bağlanmayacağı (varsayılan 1). Rust araç zincirini atlamak ve oluşturma süresini kısaltmak için 0 ayarlayın; motor ayarlar sayfasında kullanılamaz olarak gösterilir.
# WITH_ANYDOC=1
# docreader imajı oluşturulurken apt imaj kaynağı (varsayılan kaynak için boş bırakın).
# APT_MIRROR=
# frontend imajı kaynak koddan oluşturulurken sistem bilgileri sayfasına yazılan kısa commit. make docker-build-frontend
# start_all.sh --no-pull ile git üzerinden otomatik doldurulur; doğrudan docker compose build kullanırken lütfen kendiniz dışa aktarın, aksi takdirde unknown gösterilir.
# VITE_FRONTEND_COMMIT=
# frontend imajı oluşturulurken npm registry (varsayılan kaynak için boş bırakın; Çin içinde https://registry.npmmirror.com ayarlanabilir).
# NPM_REGISTRY=
# Vite oluşturma Node heap üst sınırı (MB). Docker Desktop'a ayrılan bellek düşükse 2048'e düşürülebilir.
# NODE_MAX_OLD_SPACE_SIZE=4096

# ========== A2. Çalışma zamanı temeli ==========
# gin çalışma modu: debug (geliştirme, ayrıntılı günlükler + Swagger) / release (üretim, Swagger devre dışı).
GIN_MODE=release
# Günlük seviyesi: debug / info / warn / error / fatal, varsayılan debug.
# LOG_LEVEL=debug
# Günlük dosyası yolu (yalnızca stdout çıktısı için boş bırakın); LLM_DEBUG_LOG etkin olduğunda aynı dizine llm_debug.log yazılır.
# LOG_PATH=
# Özel günlük formatı şablonu (yerleşik varsayılan format için boş bırakın).
# LOG_FORMAT=
# LLM hata ayıklama günlüğü: Her büyük model çağrısının tam isteğini/yanıtını ayrı bir dosyaya yazar; bağlam sorunlarını incelemek için kullanılır.
# İsteğe bağlı değerler: true (LOG_PATH ile aynı dizine llm_debug.log yazar) / false/boş (kapalı) / belirtilen dosya yolu.
# LLM_DEBUG_LOG=true
# Saat dilimi, varsayılan Europe/Istanbul. Sistem saati gösterimini ve günlük zaman damgalarını etkiler.
# Yaygın değerler: Europe/Istanbul, Asia/Tokyo, America/New_York, Europe/London, UTC。
TZ=Europe/Istanbul
# Sistem varsayılan dili (BCP-47), Prompt içindeki {{language}} yer tutucusu için geri dönüş olarak kullanılır.
# Öncelik: bu değişken > Accept-Language istek başlığı > yerleşik varsayılan değer (tr-TR).
# RETHRA_LANGUAGE=tr-TR
# Ön yüz arayüzü varsayılan dili (BCP-47). Seçenekler: en-US | tr-TR.
# Öncelik: kullanıcının seçtiği dil(localStorage) > bu değişken > yerleşik varsayılan tr-TR.
# Yalnızca ilk ziyaret/manuel olarak dil değiştirmemiş kullanıcıları etkiler; değişiklikten sonra frontend kapsayıcısını yeniden başlatmak yeterlidir, imajın yeniden oluşturulması gerekmez。
# DEFAULT_LOCALE=tr-TR
# Frontend imajı oluşturulurken varsayılan dil geri dönüşü (yalnızca Docker olmadan çalıştırıldığında config.js için geçerlidir).
# VITE_DEFAULT_LOCALE=tr-TR
# Başlatma sırasında veritabanı geçişlerini otomatik olarak çalıştırır; devre dışı bırakmak için false ayarlayın (varsayılan olarak etkin).
AUTO_MIGRATE=true
# Kirli veri geçişi durumunu otomatik olarak kurtarır (varsayılan true).
AUTO_RECOVER_DIRTY=true
# Başlatma sırasında belirtilen email kullanıcısını otomatik olarak sistem yöneticisine yükseltir (idempotent; yalnızca PROMOTE, asla DEMOTE değil).
# docker-compose/k8s ilk önyüklemesi için uygundur; sonraki yetki yükseltme/iptal işlemleri SystemAdmin yönetim sayfasından yapılır.
# RETHRA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=

# ========== A3. Ağ ve harici adresler ==========
# Uygulama hizmeti ana makine adı, varsayılan app'tir (Docker iç hizmet adı); uzak backend için uzak adres ayarlanabilir.
APP_HOST=app
# Uygulama hizmetinin ana makineye eşlenen portu, varsayılan 8080'dir (yalnızca ana makine erişimini etkiler, container'lar arası iletişimi etkilemez).
APP_PORT=8080
# NGINX'in backend'e proxylediği hedef port, varsayılan 8080'dir (App container'ının dahili dinleme portu).
# Yerel dağıtımda varsayılanı koruyun; uzak dağıtımda uzak App hizmetinin gerçek portuna ayarlayın.
# APP_BACKEND_PORT=8080
# NGINX'in backend'e proxylediği protokol, varsayılan http'dir; uzak backend HTTPS ise https olarak ayarlayın.
# APP_SCHEME=http
# Frontend hizmet portu, varsayılan 80'dir.
FRONTEND_PORT=80
# Docreader adresi (app'in docreader'a bağlanması için kullanılır).
DOCREADER_ADDR=docreader:50051
# Docreader bağlantı yöntemi: grpc / http / https.
DOCREADER_TRANSPORT=grpc
# Uygulamanın harici erişim adresi (IM kanallarındaki resim/dosya harici bağlantılarını etkiler).
# Rethra örneğinin «IM platformu/istemcisinden genel ağ üzerinden erişilebilir» URL'si olarak ayarlayın; örneğin https://rethra.example.com.
# IM'de bilgi tabanı resimlerini göstermek için IM tarafının resimleri genel ağ üzerinden http URL ile alabilmesi gerekir; iki seçenek vardır:
#   (A) Depolama backend'inin kendisi genel ağdan erişilebilir olmalıdır (nesne depolama için genel endpoint kullanın veya MINIO_ENDPOINT'i genel host olarak ayarlayın);
#      Bu durumda resource:// backend ön imzalı URL'sine geri döner; bu değişkene gerek yoktur.
#   (B) Bu değişkeni ayarlayın; resource:// resimleri <APP_EXTERNAL_URL>/r/<token> olarak yeniden yazılır ve Rethra üzerinden geçer (nginx'in /r/ için proxy yapması gerekir).
# Varsayılan MinIO dağıtımı (minio:9000 iç ağdır) için (B) en basitidir; local backend yalnızca (B) kullanabilir.
# İç ağ IP'leri ve localhost, Feishu/WeCom/Slack gibi IM platformları tarafından erişilemez; yerel geliştirme için ngrok/cloudflared/frp kullanın.
# APP_EXTERNAL_URL=
# Frontend harici origin, davet bağlantıları gibi mutlak URL'ler için kullanılır (boş bırakılırsa host-relative kullanılır).
# FRONTEND_BASE_URL=
# API yanıtlarındaki dosya referanslarının varsayılan biçimi: handle (varsayılan) / public.
#   handle — Dahili resource://<handle> döndürür; istemcinin görseli almak için yetkilendirmeli /files proxy'sini yeniden çağırması gerekir.
#   public — Doğrudan yüklenebilir http(s) bağlantısı döndürür; üçüncü taraf App bunu alıp ikinci bir istek gerektirmeden render edebilir.
# Tek bir istek, bu değişkeni ?resource_urls=handle|public ile geçersiz kılabilir; geçersiz kılma kapsamı için README'deki «API Referansı» bölümüne bakın.
# public, harici bağlantı oluşturabilmek için yukarıdaki APP_EXTERNAL_URL'ye (veya depolama backend'inin kendisinin internete açık olmasına) bağlıdır;
# Oluşturulamadığında bu referans resource:// olarak kalır; istemci yine /files'e geri dönebilir.
# Not: public, her referans verilen dosya için süre sınırlı (Rethra 2 saat / MinIO 24 saat) anonim okunabilir bağlantı imzalar.
# Anonim embed kanalı ve sınırlı bilgi tabanına ait API Key bu değişkenden etkilenmez, her zaman handle döndürür.
# grant satırlarını yeniden kullanmak, doğrudan bağlantı URL'lerini kararlı tutmak ve okuma arayüzlerindeki yazma yükünü azaltmak için SYSTEM_AES_KEY'nin de yapılandırılması önerilir.
# RESOURCE_URL_MODE=handle
# Dışarıya açık MCP Server portu (varsayılan 8082).
# MCP_PORT=8082


# #####################################################################
# B. Veri ve depolama
# #####################################################################

# ========== B1. Veritabanı ⚠️ Zorunlu ==========
# Ana veritabanı türü: postgres / sqlite. sqlite Lite modu için kullanılır; DB_PATH'e bakın.
DB_DRIVER=postgres
# Veritabanı ana makine adresi.
DB_HOST=postgres
# Veritabanı portu.
DB_PORT=5432
# Veritabanı kullanıcı adı.
DB_USER=postgres
# Veritabanı parolası.
DB_PASSWORD=postgres123!@#
# Veritabanı adı.
DB_NAME=Rethra
# SQLite sürücüsü kullanıldığında (DB_DRIVER=sqlite) kullanılır, postgres sürücüsü tarafından yok sayılır.
# DB_PATH=./data/rethra.db

# ========== B2. Redis / Akış işleme / Asynq kuyruğu ==========
# --- Akış işleme backend'i ve Redis bağlantısı ---
# Akış işleme backend'i: memory / redis。redis modunda Asynq görev kuyruğu da bu Redis'e bağlıdır。
STREAM_MANAGER_TYPE=redis
# Redis adresi（boş bırakmak Redis'i devre dışı bırakır，Lite modu memory kullanır）。
REDIS_ADDR=redis:6379
# Redis kullanıcı adı（Redis 6.0+ ACL，isteğe bağlı）。
# REDIS_USERNAME=
# Redis parolası，ayarlanmadıysa boş bırakılabilir。
REDIS_PASSWORD=redis123!@#
# Redis veritabanı indeksi，varsayılan 0。
REDIS_DB=0
# Redis key öneki，ad alanı izolasyonu için kullanılır。
REDIS_PREFIX=stream:
# Redis kanal ad alanı son eki（birden fazla dağıtım aynı Redis'i paylaştığında izolasyon için）。
# RETHRA_REDIS_NAMESPACE=
# Asynq istemcisi Redis okuma/yazma zaman aşımı（milisaniye，varsayılan 500，yazma 1000'e kadar artırılabilir）。
# RETHRA_REDIS_OP_TIMEOUT_MS=500

# --- Redis TLS（AWS ElastiCache gibi yönetilen Redis için şifreli aktarım；varsayılan olarak kapalı）---
# TLS'nin etkinleştirilip etkinleştirilmeyeceği。
# REDIS_USE_TLS=false
# TLS sertifika doğrulaması ve SNI için sunucu adı（adres IP olduğunda kullanışlıdır）。
# REDIS_TLS_SERVER_NAME=
# Sunucu sertifikası doğrulamasını atla。Güvenli değildir，yalnızca geliştirme/kendinden imzalı sertifikalar için；production'da devre dışı bırakın。
# REDIS_TLS_INSECURE_SKIP_VERIFY=false

# --- Asynq worker eşzamanlılığı ---
# Her pool bağımsız bir asynq.Server'dır，katı izolasyon sağlar；boş bırakılırsa veya <1 ise kod varsayılanı kullanılır。Değer「örnek başına garantili eşzamanlılık」dır；çok kopyalı dağıtımda kopya sayısına göre toplanır。Sistem ayarlarından（asynq.*_concurrency）çalışma anında da ayarlanabilir，yeniden başlatma gerekmez。Biçim：değişken = varsayılan değer — tüketilen kuyruk / açıklama
# default + chat_attachment（belge ayrıştırmanın ana hattı；chat_attachment daha yüksek ağırlıktadır，toplu içe aktarma tarafından sıkıştırılmasını önler）
# RETHRA_ASYNQ_CORE_CONCURRENCY=8
# postprocess（ayrıştırma sonrası bilgi tabanı post-processing/fan-out；uzun süreli DocReader'ın arkasında sıralanmasını önlemek için ayrı pool，düşük gecikme gerekir）
# RETHRA_ASYNQ_POSTPROCESS_CONCURRENCY=2
# summary / multimodal / graph / question（özet，görüntü çok modluluğu，graf chunk çıkarma，soru üretimi；LLM/VLM ağırlıklıdır，provider bütçesine göre ayarlayın）
# RETHRA_ASYNQ_ENRICHMENT_CONCURRENCY=12
# sync + low（veri kaynağı senkronizasyonu，FAQ içe aktarma，KB klonlama/silme，toplu yeniden ayrıştırma，bilgi taşıma；uzun sürer，shared ödünç almaya katılmaz）
# RETHRA_ASYNQ_MAINTENANCE_CONCURRENCY=4
# Esnek pool，CORE/ENRICHMENT kuyruklarını ödünç alabilir（atomic dequeue güvenlidir）；POSTPROCESS/MAINTENANCE tüketmez
# RETHRA_ASYNQ_SHARED_CONCURRENCY=6
# Wiki oluşturma için özel pool（LLM bağlıdır，provider eşzamanlılık bütçesine göre ayarlayın）
# RETHRA_WIKI_ASYNQ_CONCURRENCY=8
# Arka plan görevleri için model başına eşzamanlılık üst sınırı（0/negatif devre dışı bırakır；etkileşimli chat bundan etkilenmez）
# RETHRA_MODEL_MAX_CONCURRENCY=32

# ========== B3. Dosya depolama（genel）==========
# Dosya depolama türü: local / minio / cos / tos / s3 / obs / oss / dummy。
STORAGE_TYPE=local
# Kullanıcıların kullanmasına izin verilen depolama türleri beyaz listesi (virgülle ayrılır, boş bırakılırsa tümüne izin verilir)。
# STORAGE_ALLOW_LIST=local,minio,cos,tos,s3,obs,oss
# Yerel depolama kök dizini (STORAGE_TYPE=local olduğunda kullanılır)。
LOCAL_STORAGE_BASE_DIR=/data/files
# Yerel depolama yolu öneki (legacy geri doldurma için, genellikle boş bırakılır)。
# LOCAL_STORAGE_PATH_PREFIX=
# Birleşik dosya boyutu sınırı (MB, varsayılan 50)。Bilgi tabanı/ek tek dosya yüklemelerini, docreader gRPC mesajlarını ve tarayıcı bilgi tabanı doğrulamasını etkiler。Dağıtım dönemi yapılandırmasıdır: Go/Nginx/docreader/tarayıcı olmak üzere dört katman başlangıçta bir kez okur; çalışma sırasında yapılan değişiklikler etkili olmaz, değişiklikten sonra dört katman eşzamanlı olarak yeniden başlatılmalıdır。
# MAX_FILE_SIZE_MB=50
# Beceri zip yükleme ve GitHub/ClawHub kaynak indirme üst sınırı (MB, varsayılan 256)。Bilgi tabanı yüklemesinden ayrıdır: ppt-master türü beceri paketleri 50MB'ı aşabilir。GitHub zipball, SKILL.md alt ağacı değil, tüm depo sıkıştırma paketi üzerinden hesaplanır; depo çok büyükse indirme aşamasında yine reddedilir。Ayarlanmadığında MAX_FILE_SIZE_MB'den düşük ve 512'den yüksek olmaz。Nginx yalnızca POST /api/v1/skills/catalog ve POST /api/v1/sandbox-configs/{id}/skills için bu değere kadar izin verir; /install, PATCH ve diğer alt yollar hâlâ MAX_FILE_SIZE_MB değerini kullanır。Değişiklikten sonra app ve frontend yeniden başlatılmalıdır。
# MAX_SKILL_BUNDLE_SIZE_MB=256

# ========== B4. Nesne depolama provider'ı（STORAGE_TYPE'a göre birini seçin）==========
# ----- MinIO（STORAGE_TYPE=minio）-----
# MinIO uç noktası（host:port）。IM kanalı kullanılıyorsa, IM platformunun genel ağdan erişebileceği bir host olmalıdır（minio:9000 kullanılamaz）。
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY_ID=your_minio_access_key
# MINIO_SECRET_ACCESS_KEY=your_minio_secret_key
# MINIO_BUCKET_NAME=your_minio_bucket_name
# MINIO_PATH_PREFIX=
# MINIO_USE_SSL=false
# MinIO portu（compose eşlemesi için）。
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ----- Tencent Cloud COS（STORAGE_TYPE=cos）-----
# COS_SECRET_ID=your_cos_secret_id
# COS_SECRET_KEY=your_cos_secret_key
# COS_REGION=ap-guangzhou
# COS_BUCKET_NAME=your_cos_bucket_name
# COS_APP_ID=your_cos_app_id
# COS_PATH_PREFIX=your_cos_path_prefix
# COS_TEMP_BUCKET_NAME=your_cos_temp_bucket_name
# COS_TEMP_REGION=your_cos_temp_region
# ----- Volcengine TOS（STORAGE_TYPE=tos）-----
# TOS_ENDPOINT=https://tos-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_ACCESS_KEY=your_tos_access_key
# TOS_SECRET_KEY=your_tos_secret_key
# TOS_BUCKET_NAME=your_tos_bucket_name
# TOS_PATH_PREFIX=your_tos_path_prefix
# TOS_TEMP_BUCKET_NAME=your_tos_temp_bucket_name
# TOS_TEMP_REGION=your_tos_temp_region
# AWS S3 dosya depolama olarak kullanılıyorsa, aşağıdaki parametrelerin yapılandırılması gerekir
# AWS S3 erişim uç noktası（isteğe bağlı；boş bırakılırsa Region'a karşılık gelen standart AWS uç noktası kullanılır, örneğin https://s3.amazonaws.com）
# ----- AWS S3（STORAGE_TYPE=s3）-----
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# AWS S3 erişim anahtarı Access Key（isteğe bağlı；AK/SK ikisi de boş bırakıldığında AWS SDK varsayılan kimlik bilgisi zinciri kullanılır，
# EC2/ECS/EKS IAM Role、IRSA/Web Identity、ortam değişkenleri ve paylaşılan yapılandırma dosyası desteklenir）
# AWS S3 erişim anahtarı Secret Key（Access Key ile birlikte ya doldurulmalı ya da boş bırakılmalıdır）
# S3_SECRET_KEY=your_s3_secret_key
# S3_ACCESS_KEY=your_s3_access_key
# S3_BUCKET_NAME=your_s3_bucket_name
# S3_PATH_PREFIX=rethra/
# S3_USE_SSL=true
# S3_FORCE_PATH_STYLE=false
# ----- Huawei Cloud OBS（STORAGE_TYPE=obs）-----
# OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
# OBS_REGION=cn-north-4
# OBS_ACCESS_KEY=your_obs_access_key
# OBS_SECRET_KEY=your_obs_secret_key
# OBS_BUCKET_NAME=your_obs_bucket_name
# OBS_PATH_PREFIX=rethra/
# OBS_USE_SSL=true
# OBS_PROXY_DOMAIN=https://your-domain.com/obs
# ----- Alibaba Cloud OSS（STORAGE_TYPE=oss）-----
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_REGION=cn-hangzhou
# OSS_ACCESS_KEY=your_oss_access_key
# OSS_SECRET_KEY=your_oss_secret_key
# OSS_BUCKET_NAME=your_oss_bucket_name
# OSS_PATH_PREFIX=rethra/
# OSS_TEMP_BUCKET_NAME=your_oss_temp_bucket_name
# OSS_TEMP_REGION=your_oss_temp_region


# #####################################################################
# C. Arama ve grafik
# #####################################################################

# ========== C1. Vektör veritabanı / arama motoru ==========
# Vektör depolama türü（virgülle ayrılarak birden fazla driver kullanılabilir）：postgres / elasticsearch_v7 / elasticsearch_v8 /
# opensearch / qdrant / milvus / weaviate / doris / tencent_vectordb。
RETRIEVE_DRIVER=postgres
# Çoklu vektör veritabanında paralel arama zaman aşımı（saniye，RETRIEVE_DRIVER birden fazla driver içerdiğinde geçerlidir）。
# MULTI_STORE_RETRIEVE_TIMEOUT_SEC=
# ----- Elasticsearch v7/v8 -----
# ELASTICSEARCH_ADDR=http://localhost:9200
# ELASTICSEARCH_USERNAME=your_elasticsearch_username
# ELASTICSEARCH_PASSWORD=your_elasticsearch_password
# ELASTICSEARCH_INDEX=Rethra
# ----- OpenSearch（dev compose ile gelen tek düğümlü profile）-----
# OPENSEARCH_ADDR=http://opensearch:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_INSECURE_SKIP_VERIFY=false
# OPENSEARCH_INDEX=Rethra
# ----- Qdrant -----
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_REST_PORT=6333
# QDRANT_COLLECTION=rethra_embeddings
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_USE_TLS=false
# ----- Milvus -----
# MILVUS_ADDRESS=milvus:19530
# MILVUS_COLLECTION=rethra_embeddings
# MILVUS_METRIC_TYPE=IP          # IP(varsayılan)/COSINE/L2, değişiklikten sonra collection yeniden oluşturulmalıdır。
# Yeni Collection, content için english/chinese/default çok dilli analizörleri yapılandırır；
# Eski Collection için önce go run ./cmd/milvus-migrate çalıştırın（metric kaynak Collection'dan devralınır），
# ardından MILVUS_COLLECTION değerini hedef öneke değiştirin, MILVUS_METRIC_TYPE değerini değiştirmeyin。
# MILVUS_USERNAME=your_milvus_username
# MILVUS_PASSWORD=your_milvus_password
# MILVUS_DB_NAME=your_milvus_db_name
# ----- Weaviate -----
# Konteyner içi erişimde service:port kullanın（localhost/ana makine eşleme portunu kullanmayın）。
# WEAVIATE_HOST=weaviate:8080
# WEAVIATE_GRPC_ADDRESS=weaviate:50051
# WEAVIATE_SCHEME=http
# WEAVIATE_AUTH_ENABLED=false    # APIKey/OIDC etkinleştirildiğinde true olarak ayarlayın ve WEAVIATE_API_KEY yapılandırın。
# WEAVIATE_API_KEY=your_secret_key
# WEAVIATE_COLLECTION=your_weaviate_db_name
# ----- Apache Doris 4.1+ -----
# DORIS_ADDR=doris-fe:9030       # FE MySQL protokol adresi。
# DORIS_HTTP_PORT=8030           # FE HTTP, Stream Load partial update giriş noktası。
# DORIS_DATABASE=rethra
# DORIS_USERNAME=root
# DORIS_PASSWORD=
# DORIS_TABLE_PREFIX=rethra_embeddings
# DORIS_COMPAT_MODE=auto         # auto(algılama)/legacy(cosine_distance)/inner_product_duplicate；tablo oluşturulduktan sonra değiştirilemez。
# compose portları。
# DORIS_FE_HTTP_PORT=8030
# DORIS_FE_MYSQL_PORT=9030
# DORIS_BE_HTTP_PORT=8040
# ----- Tencent Cloud Tencent VectorDB -----
# TENCENT_VECTORDB_ADDR=http://your-instance.tencentvectordb.com
# TENCENT_VECTORDB_USERNAME=root
# TENCENT_VECTORDB_API_KEY=your_tencent_vectordb_api_key
# TENCENT_VECTORDB_DATABASE=rethra
# TENCENT_VECTORDB_COLLECTION=rethra_embeddings
# TENCENT_VECTORDB_REPLICA_NUMBER=1

# ========== C2. Bilgi grafiği（Neo4j, isteğe bağlı）==========
# Bilgi grafiği için tek küresel anahtar. true dışında bir değer graf oluşturmayı ve aramayı devre dışı bırakır（oluşturma aşamasında büyük model çağrılması gerekir ve uzun sürer）。
# Not: ENABLE_GRAPH_RAG, v0.1.6'dan itibaren NEO4J_ENABLE ile değiştirildi; Go ana uygulaması artık okumuyor ve kaldırıldı。
# NEO4J_ENABLE=false
# Neo4j bağlantı URI'si. bolt:// tek makineye doğrudan bağlanır（önerilir, yönlendirme ek yükü yoktur）；neo4j:// küme yönlendirme keşfini kullanır（tek makinede de çalışır ancak bir ek algılama yapar）。
# Rethra varsayılan olarak tek makine Neo4j dağıtır, bu nedenle bolt:// kullanılır。
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password


# #####################################################################
# D. Modeller
# #####################################################################

# ========== D1. LLM / VLM ==========
# Toplu embedding boyutu（boş bırakılırsa kod varsayılanı kullanılır）。
# BATCH_EMBED_SIZE=
# VLM tek HTTP isteği zaman aşımı（saniye, varsayılan 180；yavaş uç noktalarda context deadline zaman aşımı oluşursa artırın）。
# VLM_HTTP_TIMEOUT_SECONDS=180
# LLM akışı ham dökümü（bağlam sorunlarını gidermek için；1 etkinleştirir, varsayılan dizin ~/.rethra/investigate/llm-stream）。
# RETHRA_LLM_STREAM_RAW_DUMP=
# RETHRA_LLM_STREAM_RAW_DUMP_DIR=

# ========== D2. Yerleşik model bildirimsel yapılandırması（isteğe bağlı）==========
# config/builtin_models.yaml etkinleştirildikten sonra (bkz. config/builtin_models.yaml.example), YAML içindeki
# ${NAME} yer tutucuları uygulama başlatılırken gerçek değerleri buradan okur. Değişken adları YAML tarafından belirlenir; aşağıda yaygın adlandırmalar için referans verilmiştir.
# Ayrıntılar için website-docs/03-features/06-models.md dosyasına bakın。
#
# Yerleşik sohbet modeli
# LLM_MODEL_NAME=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=openai
#
# Yerleşik vektör modeli. Aşağıdaki adlar yalnızca builtin_models.yaml içindeki ${...} kısmına yazılırsa okunur.
# EMBEDDING_MODEL_NAME=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_PROVIDER=openai
#
# Yerleşik Rerank modeli
# RERANK_MODEL_NAME=
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_PROVIDER=generic


# #####################################################################
# E. Belge ayrıştırma
# #####################################################################

# ========== E1. Docreader gRPC ve genel ayrıştırma ==========
# ----- gRPC sunucu tarafı TLS / kimlik doğrulama (docreader ve app tarafından ortak kullanılır; istemci/sunucu aynı değerleri yapılandırmalıdır)-----
# gRPC TLS şifreli aktarımını etkinleştirir. Varsayılan false'tur (docreader yalnızca compose iç ağı üzerinden app tarafından çağrılır; düz metin yeterlidir)。
# GRPC_TLS_ENABLED=false
# Sunucu sertifikası / istemci sertifikası (mTLS için doldurun). server TLS etkin olduğunda zorunludur。
# GRPC_TLS_CERT=/path/to/server.crt
# Sertifikaya karşılık gelen özel anahtar。
# GRPC_TLS_KEY=/path/to/server.key
# CA sertifikası: client, server sertifikasını doğrulamak için kullanır; server tarafında mTLS kullanıldığında istemci sertifikalarını imzalayan CA'dır。
# GRPC_TLS_CA=/path/to/ca.crt
# TLS SNI / sertifika doğrulama adı. DOCREADER_ADDR IP kullandığında veya sertifika CN'iyle eşleşmediğinde, sertifikadaki hostname değerine ayarlayın。
# GRPC_TLS_SERVER_NAME=
# server tarafı: true olduğunda istemcinin sertifika sunması zorunlu tutulur (çift yönlü TLS / mTLS)。
# GRPC_MTLS_REQUIRE_CLIENT_CERT=false
# gRPC per-RPC kimlik doğrulama token'ı (istemci/sunucu tutarlı olmalıdır). Etkinleştirildiğinde TLS'nin de açılması şiddetle önerilir,
# aksi hâlde token her RPC ile düz metin olarak iletilir; GRPC_TLS_ENABLED=true olduğunda istemci, güvenli olmayan bağlantıda token göndermeyi reddeder。
# GRPC_AUTH_TOKEN=your-secret-token-at-least-16-bytes
# ----- gRPC hizmet parametreleri -----
# gRPC server için maksimum eşzamanlı worker sayısı (varsayılan 4)。
# DOCREADER_GRPC_MAX_WORKERS=4
# gRPC tek mesaj boyutu üst sınırı (MB, varsayılan 50)。Genellikle MAX_FILE_SIZE_MB değerini takip eder; çok büyük taranmış belge görselleri bu değeri aşabilir。
# DOCREADER_GRPC_MAX_FILE_SIZE_MB=50
# gRPC dinleme portu (varsayılan 50051) genellikle değiştirilmemelidir ve docker-compose içindeki docreader port ile aynı olmalıdır。
# DOCREADER_GRPC_PORT=50051
# ----- Genel ayrıştırma -----
# DOCX ayrıştırma için maksimum sayfa sayısı (varsayılan 0=sınırsız). Çok büyük Word belgelerinin ayrıştırma maliyetini sınırlamak için pozitif bir tam sayı (örn. 500) ayarlayın.
# DOCREADER_DOCX_MAX_PAGES=0
# MarkItDown（ağır ayrıştırıcı）eşzamanlı worker sayısı. 0 hız sınırlamayı kapatır; varsayılan 1, tek makine/GPU kısıtlı ortamlar için uygundur.
# DOCREADER_MARKITDOWN_MAX_WORKERS=1
# Giden HTTP/HTTPS proxy'si（web sayfaları / uzak görseller alınırken kullanılır）。
# DOCREADER_EXTERNAL_HTTP_PROXY=
# DOCREADER_EXTERNAL_HTTPS_PROXY=

# ========== E2. OpenDataLoader hybrid（isteğe bağlı, bilgi tabanı parser_engine_rules içinde engine: opendataloader belirtilir）==========
# ODL ağır ayrıştırıcı eşzamanlılığı（varsayılan 1）。
# DOCREADER_ODL_MAX_WORKERS=1
# hybrid mod anahtarı：off（varsayılan, salt fast yerel ayrıştırma）/ docling-fast vb.（ayrıca odl-hybrid container'ı başlatılmalıdır）。
# DOCREADER_ODL_HYBRID=off
# odl-hybrid hizmet adresi。Kod varsayılanı http://127.0.0.1:5002；docker compose http://odl-hybrid:5002 enjekte eder。
# DOCREADER_ODL_HYBRID_URL=http://odl-hybrid:5002
# hybrid mod seçimi（auto）；genellikle değiştirmeye gerek yoktur。
# DOCREADER_ODL_HYBRID_MODE=auto
# hybrid başarısız olduğunda fast moda geri dönülüp dönülmeyeceği（varsayılan false）。
# DOCREADER_ODL_HYBRID_FALLBACK=false
# hybrid çıktısı markdown'un HTML'i koruyup korumayacağı（varsayılan false）。
# DOCREADER_ODL_MARKDOWN_WITH_HTML=false
# ----- odl-hybrid container parametreleri（yalnızca --profile odl-hybrid kullanıldığında）-----
# odl-hybrid'e iletilecek ek parametreler。Varsayılan --no-ocr（dijital PDF）；taranmış belgeler için --force-ocr kullanın（EasyOCR+libGL gerekir）。
# ODL_HYBRID_EXTRA_ARGS=--no-ocr
# odl-hybrid dışa açık portu（dev compose eşlemesi için）。
# ODL_HYBRID_PORT=5002
# app başlatılırken odl-hybrid'in hazır olması için beklenecek maksimum süre（saniye）。
# ODL_HYBRID_STARTUP_WAIT_SEC=180

# ========== E3. PDF render ==========
# PDF render worker sayısı（belgeler arası eşzamanlılık, varsayılan 1）。
# DOCREADER_PDF_RENDER_MAX_WORKERS=1
# Tek bir PDF içindeki 「taranmış sayfa render'ı」 için paralel process sayısı（pdfium thread-safe değildir, process bazında paralellik）。Varsayılan CPU'ya göre min(4, cpu) alınır；büyük hacimli taranmış belgelerde seri render, CPU kısıtlı container'larda saatler sürebilir; artırmak süreyi önemli ölçüde kısaltabilir（testte 874 sayfa 117s->30s/4 process ->17s/8 process）。Hızlanmadan yararlanmak için container'a yeterli CPU atanmalıdır。
# DOCREADER_PDF_RENDER_PARALLELISM=4
# Render DPI（varsayılan 200）。
# DOCREADER_PDF_RENDER_DPI=200
# Render görseli JPEG kalitesi（varsayılan 85）。
# DOCREADER_PDF_JPEG_QUALITY=85
# Render edilen sayfa görselinin maksimum uzun kenar pikseli（varsayılan 2000）。Çok büyük sayfaların 100+MP görsellere render edilip gRPC mesaj üst sınırını aşmasını önler；daha da küçültmek görsel boyutunu azaltabilir, aşırı küçük değer OCR tanımayı etkiler（yoğun Çince için >=1600 önerilir）。
# DOCREADER_PDF_RENDER_MAX_EDGE=2000

# ========== E4. PDF taranmış belge tespiti ve zorlaması ==========
# Tüm PDF'leri zorla tam sayfa taranmış belge olarak ayrıştırır（görsellere render edilir, ardından OCR/VLM kullanılır）。Metin katmanı kalitesi düşük ancak sayfaları OCR yapılabilir PDF'ler için uygundur；etkinleştirildiğinde hız ve model çağrısı maliyeti artar。Varsayılan false（aşağıdaki eşikler tarafından otomatik belirlenir）。
# DOCREADER_PDF_FORCE_SCANNED=false
# Otomatik tespit: Bir sayfadaki görüntü nesnelerinin kapladığı alan >= bu oran olduğunda taranmış sayfa kabul edilir (varsayılan 0.5).
# DOCREADER_PDF_SCAN_IMAGE_RATIO=0.5
# Otomatik tespit: Bir sayfadaki metin karakteri sayısı bu değerden azsa 「kullanılabilir metin katmanı yok」 kabul edilir (varsayılan 10).
# DOCREADER_PDF_SCAN_MIN_CHARS=10

# ========== E5. PDF düzeni / metin çıkarma (yerel metin sayfaları)==========
# Düzen duyarlı metin çıkarma: Okunabilir okuma sırasını yeniden oluşturur (varsayılan true).
# DOCREADER_PDF_LAYOUT_ORDERING=true
# glyph açık boşluk konumlandırmasına sahip olmadığında (OCR/arama metninde yaygındır), aralık median karakter genişliğinin kaç katını aşarsa boşluk eklenir (varsayılan 0.4).
# DOCREADER_PDF_WORD_GAP_WIDTH_RATIO=0.4
# Dar kenar çubuklarını (arXiv kenar çubuğu filigranları, sayfa numarası etiketleri) atmak için sayfa genişliği oranı eşiği (varsayılan 0.12).
# DOCREADER_PDF_MARGIN_COL_WIDTH_RATIO=0.12
# Bir satırın font boyutu sezgiseliyle markdown başlığına yükseltilmesine izin vermek için gereken en az karakter sayısı (varsayılan 8).
# DOCREADER_PDF_MIN_HEADING_LINE_CHARS=8
# Görsel olarak daha büyük satırları markdown başlığına yükseltir (font boyutu vekili olarak rect yüksekliğini kullanır, varsayılan true).
# DOCREADER_PDF_DETECT_HEADINGS=true
# hidden-text enjeksiyonunu önlemek için görünmez metni (render-mode 3), sayfa dışı metni ve bozulmuş metni atar (varsayılan true).
# DOCREADER_PDF_FILTER_HIDDEN_TEXT=true
# pdfium yer tutucularını (U+FFFE) ve yumuşak tireleri temizler; vektör grafiklerin eksen/lejant metinlerini kaldırır (varsayılan true).
# DOCREADER_PDF_SANITIZE_TEXT=true
# Grafik alanındaki parçalı metni kaldırır (SANITIZE_TEXT ile birlikte, varsayılan true).
# DOCREADER_PDF_STRIP_CHART_DEBRIS=true

# ========== E6. PDF gömülü görüntü çıkarma (yerel metin sayfaları)==========
# VLM/OCR analizi için yerel sayfalardaki gömülü bitmap'leri çıkarır (varsayılan true).
# DOCREADER_PDF_EXTRACT_EMBEDDED_IMAGES=true
# Gömülü görüntülerin korunması için minimum piksel genişliği ve yüksekliği (varsayılan 80, bunun altındakiler atılır).
# DOCREADER_PDF_EMBED_MIN_PIXELS=80
# Gömülü görüntünün sayfa alanına göre minimum oranı; altındaysa atılır (varsayılan 0.01).
# DOCREADER_PDF_EMBED_MIN_AREA_RATIO=0.01
# Aynı görüntünün metin sayfalarında görünme oranı >= bu değer olduğunda üstbilgi, altbilgi vb. çalışma öğesi kabul edilip tekilleştirilir (varsayılan 0.5).
# DOCREADER_PDF_EMBED_REPEAT_PAGE_FRAC=0.5
# Her belge için çıkarılacak gömülü görüntülerin kesin üst sınırı (varsayılan 50).
# DOCREADER_PDF_EMBED_MAX_IMAGES=50

# ========== E7. PDF grafik alanı tespiti (vektör grafik bölgeleri)==========
# Tespit edilen vektör grafik alanlarını (gömülü bitmap olmadan) VLM/OCR için JPEG olarak render eder (varsayılan true).
# DOCREADER_PDF_RENDER_VECTOR_FIGURES=true
# Bir alanın grafik kabul edilmesi için satır başına gereken minimum karakter sayısı (varsayılan 18).
# DOCREADER_PDF_MIN_CHART_REGION_CHARS=18
# Bir alanın grafik kabul edilmesi için gereken minimum alan oranı (varsayılan 0.015).
# DOCREADER_PDF_MIN_CHART_REGION_AREA=0.015
# Bir alanın grafik kabul edilmesi için maksimum alan oranı (aşarsa grafik kabul edilmez, varsayılan 0.42).
# DOCREADER_PDF_MAX_CHART_REGION_AREA=0.42
# Grafiğin sayfa yüksekliğine oranının maksimum değeri; aşarsa bağımsız grafik olarak kabul edilmez (varsayılan 0.38).
# DOCREADER_PDF_MAX_FIGURE_HEIGHT_RATIO=0.38

# ========== E8. Belge işleme / görev zaman aşımı ==========
# Tek belge işleme görevinin toplam zaman aşımı (Go duration, varsayılan 2h; büyük dosyalar için artırılabilir).
# RETHRA_DOCUMENT_PROCESS_TIMEOUT=2h
# Tek DocReader RPC zaman aşımı (varsayılan 30m, önceki öğeden küçük olmalıdır).
# RETHRA_DOCREADER_CALL_TIMEOUT=30m
# Self-hosted PaddleOCR-VL HTTP istek zaman aşımı (pozitif Go duration, varsayılan 1000s; geçersiz değerler varsayılan değere döner).
# Büyük dosya örneği: bu öğe 90m, DocReader 100m, tek belge görevi 2h; dış katman zaman aşımı için pay bırakılmalıdır.
# RETHRA_PADDLEOCR_VL_TIMEOUT=1000s
# Self-hosted MinerU tek ayrıştırma zaman aşımı (pozitif Go duration, varsayılan 1000s; geçersiz değerler varsayılan değere döner).
# Çok büyük PDF'ler için de dış katmanda pay bırakmak gerekir; örneğin bu öğe 90m, DocReader 100m, tek belge görevi 2h.
# RETHRA_MINERU_TIMEOUT=1000s
# MinerU bulutunun (mineru.net) ayrıştırma sonuçlarını yoklama için maksimum süresi (pozitif Go duration, varsayılan 600s).
# RETHRA_MINERU_CLOUD_TIMEOUT=600s
# Bilgi tabanı denetimi geri kazanımı (`processing` durumunda takılan kirli verileri geri kazanır; false devre dışı bırakır, önerilmez).
# RETHRA_HOUSEKEEPING_ENABLED=true
# Sohbet eki ayrıştırma çıktılarının saklama süresi (saat, varsayılan 24).
# RETHRA_CHAT_ATTACHMENT_TTL_HOURS=24
# Tek soru-cevap turunda ek ayrıştırmasının tamamlanması için en uzun bekleme süresi (saniye, varsayılan 60; büyük/taranmış belgelerde artırın).
# RETHRA_CHAT_ATTACHMENT_WAIT_TIMEOUT_SEC=60
# Ek VLM OCR ayarlaması (taranmış belgeler/görüntü tabanlı belgeler): eşzamanlılık sayısı / maksimum sayfa sayısı.
# RETHRA_CHAT_ATTACHMENT_OCR_CONCURRENCY=8
# RETHRA_CHAT_ATTACHMENT_OCR_MAX_PAGES=8

# ========== E9. Feishu bulut belgesi ayrıştırma modu ==========
# Feishu Drive / Feishu bilgi tabanı yeni sürüm bulut belgelerini (docx) eşzamanlarken ayrıştırma yolunu kontrol eder:
#   export (varsayılan, boş bırakılabilir): `.docx` ikilisini indirmek için asenkron dışa aktarma API'sini kullanır, docreader'a verir
#     ayrıştırma. Görseller üst belgeye inline eklenir (`parent_chunk_id`, knowledge ile ilişkilendirilir); arama /
#     wiki / akıllı ajan olmak üzere üç senaryoda da görsel içeriği ilişkilendirilebilir. Bedeli: eşzamanlama yavaşlar; Feishu docx içindeki
#     file block ekleri dışa aktarımla indirilmez (kaybolur, ayrı eşzamanlanmaları gerekir); bulut belgesinde elektronik tablo,
#     çok boyutlu tablo vb. varsa, dışa aktarımdan sonra docx içine gömülü tablolara dönüşür ve rethra bu tabloları ayrıştıramaz.
#   blocks: Markdown'a dönüştürmek için blocks API'sini kullanır. Hızlıdır, docx içindeki ekleri korur; ancak görseller boş
#     `![görsel]()` yer tutucuları olarak işlenir ve bağımsız bilgi girdileri olarak depolanır; üst belgeyle içerik ilişkisi yoktur (arama /
#     wiki / ajanların hiçbiri görselleri belgeyle yeniden ilişkilendiremez); elektronik tablolar markdown tablolarına ayrıştırılır,
#     birleştirilmiş hücreler gibi stillerin kaybolma riski vardır.
# Görsel ilişkilendirmesi gerekmiyorsa, hız isteniyorsa, ekler korunacaksa veya elektronik tablo stillerinin korunması gerekiyorsa blocks olarak ayarlayın.
# Bu çözüm geçicidir; ileride daha iyi bir ayrıştırma çözümü olursa bu ortam değişkeni kaldırılıp değiştirilecektir.
# FEISHU_DOCX_PARSE_MODE=export

# #####################################################################
# F. Kimlik doğrulama ve alan izolasyonu
# #####################################################################

# ========== F1. Anahtarlar ⚠️ Zorunlu (üretimde varsayılan değeri mutlaka değiştirin)==========
# JWT imzalama anahtarı, ön uç oturum açma Token yenilemesi için kullanılır (boş bırakılırsa başlangıçta rastgele oluşturulur).
# Generate once: openssl rand -hex 32
JWT_SECRET=
# AES-256 ana anahtarı, veritabanındaki API Key gibi hassas alanların diske yazılırken şifrelenmesi için kullanılır (mutlaka 32 bayt olmalıdır).
# Şifreleme kapsamı: tenants.api_key, model API key, vektör veritabanı kimlik bilgileri, web search provider key,
# Model AppSecret vb. Eksik olduğunda veya uzunluk yanlış olduğunda şifrelenmiş alanlar çözülemez (UI boş gösterir, yeniden girilmelidir).
# Üretimde açıkça ayarlanmalı ve güvenle saklanmalıdır; kaybedilirse tüm şifrelenmiş veriler kurtarılamaz.
# Not: TENANT_AES_KEY / CRYPTO_MASTER_KEY / CRYPTO_SALT kullanımdan kaldırılmıştır. v0.4.0 itibarıyla CryptoService (PBKDF2) kaldırıldı, şifreleme standart olarak SYSTEM_AES_KEY kullanacak şekilde değiştirildi. Bu üç değişken artık Go ana uygulaması tarafından okunmuyor ve kaldırıldı.
# Generate once: openssl rand -hex 16 (32 ASCII bytes); retain existing keys on upgrade.
SYSTEM_AES_KEY=
# Optional independent signing key for embed sessions and presigned URLs.
# Generate once: openssl rand -hex 32. Falls back to a valid SYSTEM_AES_KEY.
SYSTEM_SIGNING_KEY=

# ========== F2. Kayıt ve alan politikası ==========
# Yeni kullanıcı kaydını engeller (üretimde true önerilir).
# DISABLE_REGISTRATION=false
# Etkinleştirildiğinde parola büyük/küçük harf, rakam ve özel karakter içermelidir; özel karakterler şunlardır: !@#$%^&*()_+-=[]{}|;:,.<>?
# RETHRA_AUTH_COMPLEX_PASSWORD_ENABLED=false
# Herkese açık kayıttan sonraki varsayılan alan politikası: create_personal (varsayılan, kişisel alanı otomatik oluşturur) / tenantless.
# RETHRA_AUTH_DEFAULT_TENANT_MODE=create_personal
# Normal kullanıcıların oturum açtıktan sonra alan oluşturmasına izin verilip verilmeyeceği (varsayılan true; false olduğunda yalnızca davetle katılabilirler, süper yöneticiler etkilenmez).
# RETHRA_TENANT_SELF_SERVICE_CREATION_ENABLED=true
# Alan düzeyinde RBAC etkinleştirilir (true varsayılan olarak yetkilendirmeyi zorunlu kılar / false gözlem modu: alan içi rol kontrolleri yalnızca kaydedilir, engellenmez; alanlar arası erişim her zaman engellenir).
# RETHRA_TENANT_ENABLE_RBAC=true
# Alanlar arası erişimi etkinleştirir (kullanıcının CanAccessAllTenants izniyle birlikte kullanılmalıdır; varsayılan false). Alanlar arası yönetici gerekiyorsa, veritabanını manuel olarak değiştirip ilgili kullanıcıya alanlar arası yönetim izni vermeniz gerekir
RETHRA_TENANT_ENABLE_CROSS_TENANT_ACCESS=true
# Tek bir süper yönetici olmayan kullanıcının kendi başına oluşturabileceği alan sayısı üst sınırı (>0 kotayı zorunlu kılar; =0 varsayılanı kullanır; <0 kota sınırını kapatır).
# RETHRA_TENANT_MAX_OWNED_PER_USER=
# Alan oluşturulurken full_access API Key otomatik oluşturulup token'ın yanıtta döndürülüp döndürülmeyeceği (varsayılan false, eski sürümlerle uyumlu geri dönüş anahtarı).
# RETHRA_TENANT_AUTO_CREATE_API_KEY=false
# Yeni alanlar için varsayılan depolama kotası (GB, varsayılan 10).
# RETHRA_TENANT_DEFAULT_STORAGE_QUOTA_GB=10
# Alan davet bağlantısı TTL (Go duration, varsayılan 168h=7 gün).
# RETHRA_INVITATION_TTL=168h
# Genel anahtar: Kayıtlı kullanıcılar davet edildiğinde doğrudan alana eklenir. Varsayılan false'tur, sistem ayarları sayfasından değiştirilebilir.
# RETHRA_TENANT_AUTO_ACCEPT_INVITATION=false
# Denetim günlüğü saklama gün sayısı (0 temizlemeyi devre dışı bırakır, varsayılan 90).
# RETHRA_AUDIT_RETENTION_DAYS=90

# ========== F3. OIDC kimlik doğrulama (isteğe bağlı, OIDC_AUTH_ENABLE=true ile etkinleştirilir)==========
# OIDC_AUTH_ENABLE=false
# OIDC_AUTH_ISSUER_URL=http://127.0.0.1:5556/dex
# OIDC_AUTH_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
# OIDC_AUTH_PROVIDER_DISPLAY_NAME=OIDC
# OIDC_AUTH_CLIENT_ID=client_id_for_oidc_client
# OIDC_AUTH_CLIENT_SECRET=secret_for_oidc_client
# OIDC_AUTH_DISCOVERY_URL doldurulmuşsa, aşağıdaki uç noktalar boş bırakılabilir. Yetkilendirme/Token uç noktaları açıkça doldurulmuş olsa bile,
# jwks_uri veya issuer boş olduğu sürece id_token doğrulaması için tamamlama amacıyla discovery kullanılmaya devam edilir.
# OIDC_AUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:5556/dex/auth
# OIDC_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:5556/dex/token
# OIDC_AUTH_USER_INFO_ENDPOINT=http://127.0.0.1:5556/dex/userinfo
# OIDC_AUTH_JWKS_URI=http://127.0.0.1:5556/dex/keys
# OIDC_AUTH_SCOPES="openid profile email"
# OIDC ilk otomatik hesap oluşturma sonrası alan politikası, yerel kayıtla RETHRA_AUTH_DEFAULT_TENANT_MODE'u ortak kullanır; ayrı bir yapılandırması yoktur.
# OIDC_USER_INFO_MAPPING_USER_NAME=name
# OIDC_USER_INFO_MAPPING_EMAIL=email


# #####################################################################
# G. Agent ve sandbox
# #####################################################################

# ========== G1. Agent Skills Sandbox ==========
# Sandbox backend'i, kimlik bilgileri, şablonlar, zaman aşımı ve özel ağ erişim politikalarının tümü 「Ayarlar → Sandbox backend'i」 bölümünde
# alan bazında yönetilir. Tek dağıtım düzeyi anahtar Docker backend'idir: varsayılan olarak kapalıdır, çünkü yerel
# docker.sock ana makine root'una eşdeğerdir; özel tek makine gerektiğinde true olarak değiştirin veya sistem yöneticisi tarafından
# 「Ayarlar → Sistem ayarları → Ağ güvenliği」 bölümünden açın (hemen etkili olur, yeniden başlatma gerekmez).
#
# Sunucuda (Linux) açmak için gerekenler — yalnızca bu satır yetmez:
#   1) docker-compose.yml → app.volumes altındaki "- /var/run/docker.sock:/var/run/docker.sock" satırının yorumunu kaldırın.
#      Linux'ta soket genelde root:docker (GID≠0) olur; giriş betiği appuser'ı o gruba kendisi ekler.
#      Soket GID 0 ise (ör. Docker Desktop / macOS) appuser erişemez; socat proxy + DOCKER_HOST gerekir
#      (bkz. aşağıdaki DOCKER_HOST ve yerel docker-compose.override.yml örneği).
#   2) Sandbox imajını sunucunun mimarisinde derleyin: ./scripts/build_images.sh --sandbox
#      Uygulama rethra-sandbox:main imajını kullanır; betik hem :main hem :latest etiketler.
#      "docker compose build sandbox" yalnızca :latest etiketler, uygulama bu imajı görmez.
#      Başka makinede derlenmiş arm64/amd64 imajı taşımayın.
#   3) docker compose up -d --force-recreate app → loglarda "sandbox.docker_enabled applied (enabled=true)" görülmeli.
# Öncelik: 「Sistem ayarları」ndan kaydedilen değer (veritabanı) bu ortam değişkeninin önüne geçer.
# Güvenlik: docker.sock erişimi sunucuda root yetkisine eşdeğerdir; internete açık sunucularda bilinçli açın.
RETHRA_SANDBOX_DOCKER_ENABLED=true
# Docker daemon adresi (boşsa docker CLI context'i, o da yoksa /var/run/docker.sock kullanılır).
# Soket proxy'si kullanıldığında ör.: DOCKER_HOST=unix:///run/rethra-docker/docker.sock
# DOCKER_HOST=
# Birden çok örnekte, session→sandbox binding paylaşımı için genel REDIS_ADDR yine de yapılandırılmalıdır.

# Agent büyük model çağrısı varsayılan zaman aşımı (saniye, varsayılan 120; karmaşık çıkarımlar için 300/600 gibi artırın).
# Not: Genel varsayılan; tek bir Agent veritabanında ayrı llm_call_timeout ile yapılandırılmışsa bu değer geçerlidir.
# RETHRA_AGENT_LLM_TIMEOUT=300
# MCP araçları için manuel inceleme bekleme zaman aşımı (saniye, varsayılan 600; 30s/5m/1h gibi Go duration desteklenir).
# RETHRA_AGENT_TOOL_APPROVAL_TIMEOUT=600
# MCP aracı manuel onayı başarısız olduğunda izin verilip verilmeyeceği (true izin verir / varsayılan fail-close reddeder).
# RETHRA_AGENT_TOOL_APPROVAL_FAIL_OPEN=


# #####################################################################
# H. İsteğe bağlı entegrasyonlar
# #####################################################################

# ========== H1. Web araması (SearXNG / Tavily)==========
# ===== SearXNG (isteğe bağlı kendi kendine barındırılan web araması)=====
# Etkinleştirme: `docker compose --profile searxng up -d`.
# SEARXNG_SECRET ayarlanmadığında docker-compose içindeki sabit varsayılan değer kullanılır; yerel makine/loopback dağıtımı için yeterlidir;
# SEARXNG_BIND=0.0.0.0 olarak değiştirip örneği LAN/genel ağa açıyorsanız, mutlaka openssl rand -hex 32 ile oluşturun
# ve SEARXNG_SECRET değerini açıkça ayarlayın; aksi hâlde varsayılan değer image-proxy URL imzalamak için herkes tarafından kullanılabilir.
#
# Arka uç erişim yöntemi (konteynerle dağıtım): Konsolda Provider türü olarak "SearXNG" seçin,
# Instance URL alanına http://searxng:8080 girin; docker compose, searxng ana makine adını varsayılan olarak
# SSRF_WHITELIST_EXTRA içine ekler, ek yapılandırma gerekmez.
#
# Yerel geliştirme (go run + docker compose -f docker-compose.dev.yml --profile searxng up):
# Arka uç ana makinede çalışır, published port kullanılmalıdır; Instance URL alanına http://127.0.0.1:8888 girin,
# ve 127.0.0.1 değerini aşağıdaki SSRF_WHITELIST listesine ekleyin.
#
# Port varsayılan olarak yalnızca 127.0.0.1 üzerinde dinler; limiter:false etkinleştirilmiş örneğin LAN'a açılmasını önler.
# İç ağa açmanız gerekiyorsa SEARXNG_BIND=0.0.0.0 değerini açıkça geçersiz kılın ve güvenliği kendiniz güçlendirin.
# SEARXNG_PORT=8888
# Do not set SEARXNG_PORT to the same value as APP_PORT (default 8080).
# On Linux, binding SearXNG to 127.0.0.1:8080 while the app also publishes
# :8080 makes localhost:8080 hit SearXNG first — POST /api/v1/auth/login
# then returns SearXNG's HTML 404 even though DISABLE_REGISTRATION only
# closes registration (see discussion on issue #3296). Keep SearXNG on 8888
# (or another free port).
# SEARXNG_BIND=127.0.0.1
# SEARXNG_SECRET=
# Tavily Search API Key (isteğe bağlı, Tavily web arama sağlayıcısını etkinleştirir).
# TAVILY_API_KEY=tvly-your_tavily_api_key

# ========== H2. MCP Server (isteğe bağlı, --profile full ile başlatılır)==========
# MCP Server'ın Rethra REST API'ye erişmek için kullandığı API Key (ön uçta "Ayarlar -> API Keys" bölümünde oluşturulur).
# RETHRA_API_KEY=
# HTTP/SSE aktarımı için zorunludur: mcp-server başlatılırken bu öğe yoksa başlatmayı reddeder (istemci Authorization: Bearer ile taşır).
# MCP_SERVER_AUTH_TOKEN=
# Rethra REST çağrılarının okuma zaman aşımı (saniye, varsayılan 300).
# RETHRA_CHAT_TIMEOUT=300
# Rethra arka ucunun TLS sertifikasının doğrulanıp doğrulanmayacağı (varsayılan true; kendinden imzalı sertifikalar için false ayarlanabilir).
# RETHRA_VERIFY_SSL=true
# Yüklemeye izin verilen dizinlerin beyaz listesi (virgülle ayrılır; boş bırakılması dosya yükleme aracını devre dışı bırakır).
# MCP_ALLOWED_UPLOAD_DIRS=


# #####################################################################
# I. Gözlemlenebilirlik (Langfuse, isteğe bağlı)
# #####################################################################

# ========== I1. Langfuse entegrasyonu (chat/embedding/rerank/VLM/ASR model çağrılarını izler, token tüketimini hesaplar)==========
# Ayrıntılı açıklama: website-docs/03-features/16-observability.md
#
# Seçenek A: Langfuse Cloud'a bağlanma (en kolay)
#   1) https://cloud.langfuse.com adresine giriş yapıp API Key oluşturun
#   2) Aşağıya PUBLIC_KEY / SECRET_KEY girin
#   3) docker compose up -d app
#
# Seçenek B: Kendi Langfuse kurulumunuz (LAN/intranet ortamı)
#   1) Kendi kurulum yığınını başlatın: docker compose --profile langfuse up -d
#      İlk başlatmadan sonra ClickHouse geçişi yaklaşık 1-2 dakika sürer; langfuse-web sağlıklı olana kadar sabırla bekleyin
#   2) Tarayıcıda http://localhost:3000 adresini açın, yönetici hesabı kaydedin ve API Key oluşturun
#   3) Aşağıdaki LANGFUSE_HOST=http://langfuse-web:3000 yorumunu kaldırın, yeni oluşturulan PUBLIC_KEY / SECRET_KEY değerlerini girin
#   4) docker compose up -d app
#
# PUBLIC_KEY + SECRET_KEY birlikte ayarlandığı sürece otomatik olarak etkinleşir; açıkça bir anahtar gerekmez.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse-web:3000
# Kendi barındırma modunda şu şekilde değiştirin: LANGFUSE_HOST=http://langfuse-web:3000
# İsteğe bağlı: açık anahtar (true/false, varsayılan olarak key değerlerine göre otomatik belirlenir).
# LANGFUSE_ENABLED=true
# İsteğe bağlı: Langfuse UI içinde filtrelemeyi kolaylaştırmak için sürüm / ortam etiketleri.
# LANGFUSE_RELEASE=v0.4.2
# LANGFUSE_ENVIRONMENT=production
# İsteğe bağlı: toplu raporlama ve örnekleme stratejisi (yüksek trafikli üretim ortamlarında FLUSH_AT değerinin artırılması ve SAMPLE_RATE değerinin düşürülmesi önerilir).
# LANGFUSE_FLUSH_AT=15
# LANGFUSE_FLUSH_INTERVAL=3s
# LANGFUSE_QUEUE_SIZE=2048
# LANGFUSE_REQUEST_TIMEOUT=10s
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_DEBUG=false

# ========== I2. Langfuse kendi kurulum yığını yapılandırması (yalnızca --profile langfuse kullanılırken gereklidir)==========
# Tasarım notu: kaynak kullanımını en aza indirmek için Langfuse kendi kurulum yığını, Rethra'nın mevcut kaynaklarını **yeniden kullanır**
#   - postgres：bağımsız bir "langfuse" veritabanı oluşturur (langfuse-db-init konteyneri tarafından tek seferlik oluşturulur)
#   - redis   ：bağımsız bir Redis DB numarası kullanır (varsayılan 1, Rethra 0 kullanır)
# Gerçekte eklenen yalnızca 3 kalıcı konteynerdir: langfuse-web、langfuse-worker、langfuse-clickhouse
#                         + 1 özel S3：langfuse-minio
#                         + 1 tek seferlik init：langfuse-db-init
# Langfuse Web UI dışa açık portu.
# LANGFUSE_WEB_PORT=3000
# Langfuse'a özel MinIO portu (Rethra ana MinIO 9000/9001 ile çakışmayı önler).
# LANGFUSE_MINIO_S3_PORT=9100
# LANGFUSE_MINIO_CONSOLE_PORT=9101
# Medya yükleme harici endpoint'i (tarayıcı doğrudan Langfuse MinIO'ya bağlanır), varsayılan olarak ana makineye eşlenen 9100 portunu gösterir.
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9100
# Rethra-postgres içinde oluşturulan Langfuse veritabanı adı.
# LANGFUSE_DB_NAME=langfuse
#Rethra-redis içinde kullanılan DB numarası (1~15, Rethra'nın 0'ı ile çakışmasın).
# LANGFUSE_REDIS_DB=1
#ClickHouse / Langfuse için özel MinIO kimlik bilgileri (üretimde mutlaka değiştirin).
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_USER=langfuseminio
# LANGFUSE_MINIO_PASSWORD=langfuseminiosecret
#Langfuse temel güvenlik alanları, üretimde yeniden oluşturulmalıdır:
#   LANGFUSE_SALT=$(openssl rand -base64 32)
#   LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -base64 32)
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
# LANGFUSE_TELEMETRY_ENABLED=false
#İsteğe bağlı: ilk başlatmayı otomatikleştirin (doldurduktan sonra yönetici+proje doğrudan eklenir, UI kaydı atlanır).
# LANGFUSE_INIT_ORG_ID=Rethra
# LANGFUSE_INIT_ORG_NAME=Rethra
# LANGFUSE_INIT_PROJECT_ID=Rethra
# LANGFUSE_INIT_PROJECT_NAME=Rethra
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-rethra-init
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-rethra-init
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_NAME=Admin
# LANGFUSE_INIT_USER_PASSWORD=change-me-please


# #####################################################################
#J. Güvenlik ve dağıtım optimizasyonu
# #####################################################################

#========== J1. SSRF koruması ==========
#SSRF doğrulama izin listesi (isteğe bağlı). Virgülle ayrılır; her öğe şunlardan biri olabilir: tam alan adı(api.internal), joker karakterli alan adı(*.example.com),
#IPv4(203.0.113.5), IPv6(2001:db8::1, köşeli parantez olmadan) veya CIDR(10.0.0.0/8, 2001:db8::/32).
#Listeye eklenenler, URL doğrulaması gibi yerlerde normal SSRF kurallarını atlar; üretim ortamında dikkatli yapılandırın.
# SSRF_WHITELIST=internal.service,*.corp.example,172.16.0.0/12,2001:db8::1,fd00::/8
#
#Yalnızca izin listesindeki çıkışlara izin ver (varsayılan olarak kapalı). true olarak ayarlandığında izin listesi tüm çıkış politikası olur: SSRF_WHITELIST /
#SSRF_WHITELIST_EXTRA içinde olmayan ana bilgisayarlar (doğrudan IP bağlantıları dahil) DNS sorgusu başlatılmadan önce doğrudan reddedilir; alan adları yalnızca ada göre eşleşir,
#artık çözümleme sonuçları üzerinden CIDR ile eşleştirilmez. Çevrimdışı veya iç ağ dağıtımlarında etkinleştirilmesi ve model, vektör veritabanı, nesne depolama gibi tüm adreslerin izin listesine eklenmesi önerilir.
# SSRF_DNS_WHITELIST_ONLY=false
#
#===== Vektör veritabanı adresi için SSRF doğrulaması =====
#API aracılığıyla vektör veritabanı bağlantısı oluşturulurken/test edilirken adres SSRF doğrulamasından geçer. docker-compose yerleşik hizmetleri
#(qdrant, milvus, weaviate, doris-fe, doris-be, searxng, minio), SSRF_WHITELIST_EXTRA aracılığıyla varsayılan olarak izinlidir.
#Harici özel ağ adresi veya engellenen bir port (5432, 9200 vb.) kullanılıyorsa ana bilgisayarı SSRF_WHITELIST_EXTRA içine ekleyin
#(not: bu değişkeni özelleştirmek compose varsayılan değerlerini geçersiz kılar; yerleşik hizmet adlarını yeniden eklemeniz gerekir), örneğin:
#   SSRF_WHITELIST_EXTRA=searxng,qdrant,milvus,weaviate,doris-fe,doris-be,minio,my-opensearch.internal
#
#Doris Stream Load: FE, isteği 307 ile BE'ye yönlendirir; docker compose varsayılan olarak
#doris-fe ve doris-be'ye izin verir (bkz. SSRF_WHITELIST_EXTRA).
#
#Yerel geliştirme (go run + docker-compose.dev.yml --profile opensearch): backend ana makinede çalışır,
#OpenSearch, published port http://localhost:9200 üzerinden erişilir; API aracılığıyla bu vektör veritabanını oluşturmadan önce,
#localhost'u SSRF_WHITELIST içine eklemeniz gerekir (9200 engellenen bir porttur, localhost ise kısıtlı bir ana bilgisayar adıdır):
#   SSRF_WHITELIST=localhost
# Orijinal URL'lerin resim alan adı beyaz listesi (isteğe bağlı, virgülle ayrılır). Yapılandırıldıktan sonra bu alan adlarındaki resimler yine indirilip analiz edilir
# (OCR/altyazı), ancak markdown içinde orijinal URL korunur ve nesne depolamadaki provider:// URL ile değiştirilmez.
# IMAGE_HOST_KEEP_URL=mineru.internal.example.com

# ========== J2. Proxy ve eşzamanlılık ==========
# gin tarafından güvenilen proxy CIDR'leri (virgülle ayrılır). Varsayılan olarak loopback + özel ağ aralıklarına güvenilir (kapsayıcı ağı içindeki nginx zaten kapsanır).
# Açıkça boş dize olarak ayarlamak proxy güvenini devre dışı bırakır (ClientIP doğrudan bağlı karşı tarafı döndürür). Üretimde çok katmanlı proxy arkasında dağıtım yaparken gerçek duruma göre doldurulmalıdır.
# RETHRA_TRUSTED_PROXIES=
# ants goroutine havuzu boyutu (Embedding eşzamanlılığı; 429 görüldüğünde azaltın).
CONCURRENCY_POOL_SIZE=5

# ========== J3. BrowserSkill yerel tarayıcı (isteğe bağlı) ==========
# Kullanıcılar Chrome uzantısı üzerinden bağlanır; dağıtım ve kısıtlamalar için website-docs/05-clients/09-local-browser.md dosyasına bakın.
# Docker app imajı bsk ve ilgili uzantıyı yerleşik olarak içerir; varsayılan olarak kullanıcının geçerli sayfasından bağlantı adresini otomatik oluşturur, PUBLIC_URL yapılandırması gerekmez.
# Yerel dağıtımda ayrıca derleme çıktısı oluşturulmalı ve aşağıdaki iki dosya yolu yapılandırılmalıdır; BROWSERSKILL_BINARY= açıkça ayarlanarak bu özellik kapatılabilir.
# Backend'in bulunduğu sistem/mimari için resmi bsk çalıştırılabilir dosyasının mutlak yolu (Docker'da önceden ayarlanmıştır, tekrar yapılandırmaya gerek yoktur).
# BROWSERSKILL_BINARY=/opt/rethra/browserskill/bsk
# İsteğe bağlı geçersiz kılma: yalnızca ağ geçidinin bağımsız alan adı/yol vb. kullandığı özel dağıtımlarda ayarlayın; uzaktan dağıtımda WSS kullanılmalıdır (intranet dahil).
# BROWSERSKILL_PUBLIC_URL=wss://rethra.example.com/api/v1/local-browser/extension
# Tek bir uygulama örneği bir daemon paylaşır; tutulacak maksimum kullanıcı eşleştirme kaydı sayısı (varsayılan 32, gerçek test edilmiş kapasite değildir).
# BROWSERSKILL_MAX_CONNECTIONS=32
# Kişisel ayarlardan indirilebilen ilgili uzantı ZIP'i (sunucudaki yerel mutlak yol, Docker'da önceden ayarlanmıştır).
# BROWSERSKILL_EXTENSION_PATH=/opt/rethra/browserskill/browser-skill-rethra-0.3.1.zip
# Çoklu kopya: her düğüm, diğer düğümlerin doğrudan erişebileceği adresi yazmalıdır; yük dengeleyici adresini kullanmayın.
# BROWSERSKILL_INTERNAL_URL=http://10.0.0.12:8080
# Tüm kopyalar aynı rastgele anahtarı kullanır (en az 32 karakter); Secret üzerinden enjekte edin, depoya göndermeyin.
# BROWSERSKILL_CLUSTER_SECRET=
